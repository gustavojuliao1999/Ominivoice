# Token do HuggingFace — obrigatório para baixar modelos sem rate limit
# Gere em: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Caminhos dos modelos (network volume do RunPod ou local)
HF_HOME=/runpod-volume/huggingface
WHISPER_CACHE=/runpod-volume/whisper

# Whisper
WHISPER_ENABLED=true
# WHISPER_MODEL=large-v3   # opções: tiny, base, small, medium, large-v2, large-v3

# Overrides para GPUs com pouca VRAM ou sem suporte eficiente a float16
# (ex.: Pascal/GTX 10xx). Sem essas variáveis, o Whisper roda no mesmo
# device do OmniVoice (cuda, compute_type float16) por padrão.
# WHISPER_DEVICE=cpu              # força o Whisper a rodar na CPU
# WHISPER_COMPUTE_TYPE=int8       # opções: int8, int8_float16, float16, float32

# Vozes treinadas (fine-tuning LoRA) — diretório onde ficam
# voices/<voice_id>/{dataset,adapter,meta.json}. Use um volume persistente
# (ex.: network volume do RunPod) para não perder vozes treinadas entre
# reinícios do container.
# VOICES_DIR=/runpod-volume/voices

# ID do modelo base OmniVoice no Hugging Face (raramente precisa mudar)
# OMNIVOICE_MODEL_ID=k2-fsa/OmniVoice
